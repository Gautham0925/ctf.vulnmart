worker_processes auto;
events { worker_connections 4096; }
http {
  include /etc/nginx/mime.types;
  server_tokens off;
  client_max_body_size 64k;
  keepalive_timeout 30;
  gzip on;
  gzip_types text/css application/javascript application/json;

  limit_req_zone $binary_remote_addr zone=perip:10m rate=300r/s;
  limit_conn_zone $binary_remote_addr zone=connip:10m;
  limit_req_status 429;

  upstream flagdesk { server flagdesk:8000; keepalive 64; }
  upstream shop_api { server vulnmart-backend:8000; keepalive 64; }
  upstream shop_ui { server vulnmart-frontend:80; keepalive 16; }

  map $http_upgrade $connection_upgrade { default ""; }

  server {
    listen 80;
    server_name ${CTF_HOST};
    limit_req zone=perip burst=600 nodelay;
    limit_conn connip 400;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    location /internal/ { return 404; }
    location / {
      proxy_pass http://flagdesk;
      proxy_http_version 1.1;
      proxy_set_header Connection "";
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $remote_addr;
      proxy_set_header X-Forwarded-Proto $scheme;
      proxy_connect_timeout 3s;
      proxy_read_timeout 20s;
    }
  }

  server {
    listen 80;
    server_name ${SHOP_HOST};
    limit_req zone=perip burst=600 nodelay;
    limit_conn connip 400;
    add_header X-Content-Type-Options nosniff always;
    location ~ ^/(api|legacy|promo)/ {
      proxy_pass http://shop_api;
      proxy_http_version 1.1;
      proxy_set_header Connection "";
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $remote_addr;
      proxy_set_header X-Forwarded-Proto $scheme;
      proxy_connect_timeout 3s;
      proxy_read_timeout 20s;
    }
    location / {
      proxy_pass http://shop_ui;
      proxy_http_version 1.1;
      proxy_set_header Connection "";
      proxy_set_header Host $host;
    }
  }

  server {
    listen 80 default_server;
    return 444;
  }
}
